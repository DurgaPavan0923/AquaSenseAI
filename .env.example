# AquaSense AI Environment Configuration Template
AQUASENSE_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=aquasense-dev-secret-key-2026

# Database Configuration (Defaults to SQLite for local development; PostgreSQL for production)
DATABASE_URL=sqlite:///./aquasense.db
# DATABASE_URL=postgresql+psycopg2://aquasense_admin:aquasense_secure_pwd@localhost:5432/aquasense

# Machine Learning & Storage Paths
MODEL_DIR=artifacts/models/xgboost_active
CONFIG_PATH=config/config.yaml
LOG_LEVEL=INFO

# Kaggle API Credentials (Optional if downloading via Kaggle API)
KAGGLE_USERNAME=
KAGGLE_KEY=
