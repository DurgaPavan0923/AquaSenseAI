{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "web",
  "functions": {
    "api/index.py": {
      "maxDuration": 15,
      "memory": 1024,
      "excludeFiles": "{data/**,notebooks/**,results/**,outputs/**,tests/**,docs/**,app/**,src/**/train*,reports/**,artifacts/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(health|predict|explain|anomaly|models)(.*)",
      "destination": "/api/index.py?_route=/$1$2"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?_route=/$1"
    },
    {
      "source": "/api",
      "destination": "/api/index.py?_route=/health"
    }
  ]
}
