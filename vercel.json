{
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "web",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.py": {
      "maxDuration": 15,
      "memory": 1024,
      "excludeFiles": "{data/**,notebooks/**,results/**,outputs/**,tests/**,docs/**,app/**,src/**/train*,reports/**,artifacts/**}"
    }
  },
  "routes": [
    {
      "src": "/(health|predict|explain|anomaly|models)(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/figures/(.*)",
      "dest": "/outputs/figures/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
